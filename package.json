{
  "name": "dsh-majed",
  "version": "0.2.0",
  "description": "Majed's toolkit plugin for DeepSeek Harness (DSH): bidirectional (RTL/LTR) text, app UI font and size controls, notifications, and per-session command auto-approval.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rtl",
    "arabic",
    "persian",
    "hebrew",
    "settings"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Majed Sief Alnasr",
  "homepage": "https://github.com/majedsiefalnasr/dsh-majed#readme",
  "bugs": {
    "url": "https://github.com/majedsiefalnasr/dsh-majed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majedsiefalnasr/dsh-majed.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/read-page-native.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "fonts/*.woff2",
    "fonts/manifest.json",
    "fonts/LICENSE-*.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/appearance-contract.test.js test/classify.test.cjs test/read-page-native.test.js"
  },
  "icon": "icon.svg"
}
