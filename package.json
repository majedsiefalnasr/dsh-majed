{
  "name": "dsh-majed",
  "version": "0.2.0",
  "description": "Majed's personal DeepSeek Harness toolkit: bidirectional (RTL/LTR) text support for Arabic, Persian and Hebrew, plus extra Settings > General options such as an app-UI font size.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "rtl",
    "arabic",
    "persian",
    "hebrew",
    "settings"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Majed Sief Alnasr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majedsiefalnasr/dsh-majed.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "fonts/*.woff2",
    "fonts/manifest.json",
    "fonts/LICENSE-*.txt",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
