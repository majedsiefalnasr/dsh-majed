{
  "name": "dsh-waycraft",
  "version": "0.3.0-rc.1",
  "description": "Waycraft for DSH: interface and workflow enhancements, bidirectional text, subscription providers and account usage controls for DeepSeek Harness.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "rtl",
    "arabic",
    "persian",
    "hebrew",
    "settings"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Majed Sief Alnasr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majedsiefalnasr/dsh-waycraft.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./subscriptions": "./dist/subscriptions.js",
    "./skills": "./dist/skills.js",
    "./skills/locale/*.json": "./skills/locale/*.json",
    "./skills/icon": "./icon.svg",
    "./subscriptions/locale/*.json": "./subscriptions/locale/*.json",
    "./subscriptions/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "fonts/*.woff2",
    "fonts/manifest.json",
    "fonts/LICENSE-*.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "src/PROVENANCE.md",
    "subscriptions/locale/*.json",
    "skills/locale/*.json",
    "skills/LICENSE-APACHE-2.0"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsdown && node scripts/assemble-client.mjs",
    "test": "node scripts/prepare-test-dirs.mjs && node scripts/classifier-test-adapter.mjs && node test/classify.test.cjs && tsc -p tsconfig.reference.json && node --test lib-test/test/reference/*.spec.js test/*.test.mjs",
    "check:build": "node scripts/check-build.mjs",
    "format": "node scripts/quality.mjs format",
    "format:check": "node scripts/quality.mjs format:check",
    "lint": "node scripts/quality.mjs lint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json && tsc -p tsconfig.reference.json --noEmit",
    "quality": "npm run format:check && npm run lint && npm run typecheck",
    "ci": "npm run quality && npm test && npm run check:build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "undici": "^7.30.1",
    "yaml": "2.8.1"
  }
}
